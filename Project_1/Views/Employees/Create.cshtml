@model Employee
@{
    ViewData["Title"] = "Add Employee";
}
<h1 class="text-center">Add Employee</h1>

<form action="Create" method="post">
    <label>Employee Name :</label>
    <input type="text" asp-for="Name" name="Name" id="Name" placeholder="Enter Your Name" />
    <br /><br />
    <label>Employee Email :</label>
    <input type="email" asp-for="Email" name="Email" id="Email" placeholder="Enter Your Email" />
    <br /><br />
    <label>Employee Phone :</label>
    <input type="tel" asp-for="Phone" name="Phone" id="Phone" placeholder="Enter Your Phone" />
    <br /><br />
    <label>Employee Address :</label>
    <input type="text" asp-for="Address" name="Address" id="Address" placeholder="Enter Your Address" />
    <br /><br />
    <label>Employee Salary :</label>
    <input type="number" asp-for="Salary" name="Salary" id="Salary" placeholder="Enter Your Salary" min="3000" max="10000" title="Enter a salary between $3,000 and $10,000" />
    <br /><br />
    <button type="submit" class="btn btn-success">Save</button>
</form>

