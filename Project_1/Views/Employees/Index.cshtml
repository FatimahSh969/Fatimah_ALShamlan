<h1>Employee Info</h1>
<table class="table table-bord">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Address</th>
            <th>City</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Email</td>
                <td>@employee.Phone</td>
                <td>@employee.Address</td>
                <td>@employee.Salary</td>
            </tr>
        }
    </tbody>
    </table>
<a asp-action="Create" class="btn btn-primary">Add Employee</a>